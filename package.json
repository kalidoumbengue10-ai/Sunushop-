{
  "name": "sunushop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "npx --yes eslint@9.39.5 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "supabase:types": "supabase gen types typescript --local --schema public > lib/infrastructure/supabase/database.generated.ts",
    "db:dump": "supabase db dump --local --file reports/sunushop-local.sql",
    "admin:bootstrap": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "export:db": "node scripts/dump-database.mjs",
    "export:auth": "node scripts/export-auth-users.mjs",
    "export:storage": "node scripts/export-storage.mjs",
    "export:portable": "npm run export:db && npm run export:auth && npm run export:storage"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^0.553.0",
    "next": "^16.2.12",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.25",
    "supabase": "^2.110.0",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "2.0.2"
    }
  }
}
