# Garder false tant que l’identité commerciale, le domaine et les services réels ne sont pas validés.
NEXT_PUBLIC_SITE_IS_LIVE=false
# En local. Sur Vercel, utiliser https://app.sunushop.fr.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public. La publishable key peut être exposée au navigateur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Authentification email. Utilisé par le CLI lors du `supabase config push`.
# Ne jamais placer la vraie clé dans Git ni dans une variable NEXT_PUBLIC_*.
RESEND_API_KEY=
SUNUSHOP_EMAIL_FROM=SunuShop <noreply@sunushop.fr>
SUNUSHOP_CRM_NOTIFICATION_EMAIL=
SUNUSHOP_OPERATIONS_NOTIFICATION_EMAIL=
SUNUSHOP_EMAIL_REPLY_TO=contact@sunushop.fr
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_HASH_SECRET=
CRON_SECRET=
PRELAUNCH_INGEST_SECRET=

# Paramètres du pilote.
SUNUSHOP_ENVIRONMENT=development
SUNUSHOP_WAVE_MERCHANT_NUMBER=
SUNUSHOP_ORANGE_MONEY_MERCHANT_NUMBER=
SUNUSHOP_KYC_SIGNED_URL_TTL_SECONDS=300
SUNUSHOP_KYC_REJECTED_RETENTION_DAYS=90
SUNUSHOP_KYC_CLOSED_RETENTION_DAYS=365
DELIVERY_CODE_SECRET=

# Intégrations optionnelles futures.
PUSH_PROVIDER_SECRET=
MAPS_PROVIDER_SECRET=
